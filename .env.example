# --- Root Account (るーとの研究室 共通アカウント基盤) ---
# root-accountリポジトリのSupabaseプロジェクトの値を設定する。
# mekuru独自のSupabaseプロジェクトはもう使わない。
NEXT_PUBLIC_ROOT_ACCOUNT_URL=
NEXT_PUBLIC_ROOT_ACCOUNT_ANON_KEY=
NEXT_PUBLIC_ROOT_ACCOUNT_COOKIE_DOMAIN=.astro-root.com
# service_role キー。絶対にクライアントへ公開しないこと。
# 学習リマインダーのcronジョブ・お問い合わせ管理画面(サーバー側のみ)で使用します。
ROOT_ACCOUNT_SERVICE_ROLE_KEY=

# 学習リマインダー機能(任意。設定しない場合、リマインダーは送信されません)
# Vercel Cronからこのシークレットを Authorization: Bearer <値> で受け取り、
# 一致しない場合はcronエンドポイントを拒否します。
CRON_SECRET=
# https://resend.com のAPIキー
RESEND_API_KEY=
# Resendで送信ドメイン認証済みの送信元アドレス(例: reminder@example.com)
REMINDER_FROM_EMAIL=
